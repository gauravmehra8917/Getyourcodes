\set ON_ERROR_STOP on

DROP SCHEMA IF EXISTS a11_i2_contention CASCADE;
CREATE SCHEMA a11_i2_contention;

CREATE TABLE a11_i2_contention.requests (
  case_id text NOT NULL,
  side text NOT NULL CHECK (side IN ('A', 'B')),
  integration_id uuid NOT NULL,
  actor_id uuid NOT NULL,
  fingerprint text NOT NULL CHECK (fingerprint ~ '^[0-9a-f]{64}$'),
  evaluated_at timestamptz NOT NULL,
  store_action text NOT NULL CHECK (store_action IN ('create', 'noop_existing')),
  campaign_id text NOT NULL,
  campaign_name text NOT NULL,
  slug text NOT NULL,
  ad_id text,
  PRIMARY KEY (case_id, side)
);

CREATE TABLE a11_i2_contention.results (
  case_id text NOT NULL,
  side text NOT NULL CHECK (side IN ('A', 'B')),
  result jsonb NOT NULL,
  PRIMARY KEY (case_id, side)
);

CREATE FUNCTION a11_i2_contention.expected_counts(
  _store_create integer,
  _store_existing integer,
  _offer_create integer
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'stores', jsonb_build_object(
      'create', _store_create,
      'noopExisting', _store_existing,
      'blockedAmbiguous', 0,
      'noopUnmatched', 0
    ),
    'offers', jsonb_build_object(
      'create', _offer_create,
      'noopExisting', 0,
      'noopHeld', 0,
      'noopUnresolved', 0
    ),
    'writableStores', _store_create,
    'writableOffers', _offer_create,
    'writableEntities', _store_create + _offer_create
  );
$function$;

CREATE FUNCTION a11_i2_contention.store_create(
  _campaign_id text,
  _campaign_name text,
  _slug text,
  _evaluated_at timestamptz
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'instructionOrdinal', 0,
    'action', 'create',
    'provider', 'impact',
    'providerEntityNamespace', 'campaign',
    'providerEntityId', _campaign_id,
    'expectedExistingStoreId', NULL,
    'qualified', true,
    'projection', jsonb_build_object(
      'name', _campaign_name,
      'slugCandidate', _slug,
      'description', NULL,
      'affiliateUrl', 'https://destination.invalid/campaign/' || _campaign_id,
      'destinationUrl', 'https://destination.invalid/campaign/' || _campaign_id,
      'country', NULL,
      'shippingRegions', '[]'::jsonb,
      'logoSourceUrl', NULL,
      'metadata', jsonb_build_object(
        'advertiserId', 'advertiser-' || _campaign_id,
        'campaignId', _campaign_id,
        'campaignName', _campaign_name,
        'destinationUrl', 'https://destination.invalid/campaign/' || _campaign_id,
        'trackingUrl', 'https://tracking.invalid/campaign/' || _campaign_id
      ),
      'importOrigin', 'provider',
      'lifecycleManaged', true,
      'lifecycleHidden', false,
      'lastQualificationResult', 'qualified',
      'lastQualifiedAt', _evaluated_at,
      'seoTitle', _campaign_name || ' Coupon Codes',
      'seoDescription', 'Save with ' || _campaign_name || '.',
      'seoCanonicalUrl', 'https://site.invalid/' || _slug || '-coupons'
    )
  );
$function$;

CREATE FUNCTION a11_i2_contention.store_existing(
  _campaign_id text,
  _store_id uuid
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'instructionOrdinal', 0,
    'action', 'noop_existing',
    'provider', 'impact',
    'providerEntityNamespace', 'campaign',
    'providerEntityId', _campaign_id,
    'expectedExistingStoreId', _store_id,
    'qualified', true,
    'projection', NULL
  );
$function$;

-- SQL-only fixture slugging is deliberately limited to fixture identifiers.
CREATE FUNCTION a11_i2_contention.slugify(_value text)
RETURNS text
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT trim(BOTH '-' FROM regexp_replace(lower(_value), '[^a-z0-9]+', '-', 'g'));
$function$;

CREATE FUNCTION a11_i2_contention.offer_create(
  _ad_id text,
  _campaign_id text,
  _campaign_name text,
  _expected_store_id uuid
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'instructionOrdinal', 1,
    'action', 'create',
    'provider', 'impact',
    'providerEntityNamespace', 'ad',
    'providerEntityId', _ad_id,
    'kind', 'coupon',
    'existingOfferId', NULL,
    'parentProviderEntityNamespace', 'campaign',
    'parentProviderEntityId', _campaign_id,
    'expectedParentStoreId', _expected_store_id,
    'projection', jsonb_build_object(
      'title', 'Contention ' || _ad_id,
      'description', NULL,
      'couponCode', 'CONTEND20',
      'couponType', 'code',
      'affiliateUrl', 'https://tracking.invalid/ad/' || _ad_id,
      'landingPageUrl', 'https://landing.invalid/ad/' || _ad_id,
      'startDate', '2026-09-01',
      'expiryDate', '2026-12-31',
      'status', 'active',
      'terms', NULL,
      'discountType', 'percentage',
      'discountValue', 20,
      'structuredTerms', NULL,
      'metadata', jsonb_build_object(
        'adId', _ad_id,
        'campaignId', _campaign_id,
        'advertiserId', 'advertiser-' || _campaign_id,
        'dealId', NULL,
        'campaignName', _campaign_name,
        'adName', 'Contention ' || _ad_id,
        'dealStartDate', '2026-09-01',
        'dealEndDate', '2026-12-31',
        'startDate', NULL,
        'endDate', NULL
      ),
      'seoTitle', 'Contention ' || _ad_id,
      'seoDescription', 'Contention fixture for ' || _campaign_name || '.',
      'seoCanonicalUrl', 'https://site.invalid/' ||
        a11_i2_contention.slugify(_campaign_id) || '-coupons#' ||
        a11_i2_contention.slugify(_ad_id)
    )
  );
$function$;

CREATE FUNCTION a11_i2_contention.execute_request(_case_id text, _side text)
RETURNS jsonb
LANGUAGE plpgsql
AS $function$
DECLARE
  request a11_i2_contention.requests%ROWTYPE;
  store_id uuid;
  stores jsonb;
  offers jsonb;
BEGIN
  SELECT * INTO STRICT request
  FROM a11_i2_contention.requests
  WHERE case_id = _case_id AND side = _side;

  IF request.store_action = 'create' THEN
    store_id := NULL;
    stores := jsonb_build_array(a11_i2_contention.store_create(
      request.campaign_id,
      request.campaign_name,
      request.slug,
      request.evaluated_at
    ));
  ELSE
    SELECT id INTO STRICT store_id
    FROM public.stores
    WHERE provider = 'impact'
      AND provider_entity_namespace = 'campaign'
      AND provider_entity_id = request.campaign_id;
    stores := jsonb_build_array(a11_i2_contention.store_existing(
      request.campaign_id,
      store_id
    ));
  END IF;

  offers := CASE WHEN request.ad_id IS NULL
    THEN '[]'::jsonb
    ELSE jsonb_build_array(a11_i2_contention.offer_create(
      request.ad_id,
      request.campaign_id,
      request.campaign_name,
      store_id
    ))
  END;

  RETURN public.apply_affiliate_persistence_plan_v2(
    request.integration_id,
    'impact',
    'v2-a11-ads-1',
    'sha256-canonical-plan-v1',
    request.fingerprint,
    request.evaluated_at,
    request.actor_id,
    a11_i2_contention.expected_counts(
      CASE WHEN request.store_action = 'create' THEN 1 ELSE 0 END,
      CASE WHEN request.store_action = 'noop_existing' THEN 1 ELSE 0 END,
      CASE WHEN request.ad_id IS NULL THEN 0 ELSE 1 END
    ),
    stores,
    offers
  );
END;
$function$;

CREATE FUNCTION a11_i2_contention.validate_results()
RETURNS text
LANGUAGE plpgsql
AS $function$
DECLARE
  case_number integer;
  actual_runs integer;
  result_runs integer;
BEGIN
  IF (SELECT count(*) FROM a11_i2_contention.results) <> 14 THEN
    RAISE EXCEPTION 'expected fourteen contention results';
  END IF;

  FOR case_number IN 1..3 LOOP
    IF NOT EXISTS (
      SELECT 1 FROM a11_i2_contention.results
      WHERE case_id = 'same-' || case_number AND side = 'A'
        AND result->>'status' = 'committed'
        AND result#>>'{counts,actual,storesCreated}' = '1'
        AND result#>>'{counts,actual,offersCreated}' = '1'
    ) OR NOT EXISTS (
      SELECT 1 FROM a11_i2_contention.results
      WHERE case_id = 'same-' || case_number AND side = 'B'
        AND result->>'status' = 'committed'
        AND result#>>'{counts,actual,storesNoopExisting}' = '1'
        AND result#>>'{counts,actual,offersNoopExisting}' = '1'
    ) THEN
      RAISE EXCEPTION 'same exact identities did not reconcile create to noop: %', case_number;
    END IF;

    IF (SELECT count(*) FROM public.stores
        WHERE provider = 'impact' AND provider_entity_namespace = 'campaign'
          AND provider_entity_id = 'campaign-same-' || case_number) <> 1
      OR (SELECT count(*) FROM public.coupons
          WHERE provider = 'impact' AND provider_entity_namespace = 'ad'
            AND provider_entity_id = 'ad-same-' || case_number) <> 1
    THEN
      RAISE EXCEPTION 'same exact identity duplicated: %', case_number;
    END IF;
  END LOOP;

  IF NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'different-offers' AND side = 'A'
      AND result->>'status' = 'committed'
      AND result#>>'{counts,actual,storesCreated}' = '1'
      AND result#>>'{counts,actual,offersCreated}' = '1'
  ) OR NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'different-offers' AND side = 'B'
      AND result->>'status' = 'committed'
      AND result#>>'{counts,actual,storesNoopExisting}' = '1'
      AND result#>>'{counts,actual,offersCreated}' = '1'
  ) OR (SELECT count(*) FROM public.coupons
        WHERE provider = 'impact' AND provider_entity_namespace = 'ad'
          AND provider_entity_id IN ('ad-different-a', 'ad-different-b')) <> 2
  THEN
    RAISE EXCEPTION 'shared Campaign with different Ads did not reconcile safely';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'parent-conflict' AND side = 'A'
      AND result->>'status' = 'committed'
      AND result#>>'{counts,actual,offersCreated}' = '1'
  ) OR NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'parent-conflict' AND side = 'B'
      AND result @> '{"status":"blocked","stage":"offer_revalidation","reason":"parent_store_mismatch"}'::jsonb
  ) OR (SELECT count(DISTINCT offer.store_id) = 1
        FROM public.coupons AS offer
        WHERE offer.provider = 'impact'
          AND offer.provider_entity_namespace = 'ad'
          AND offer.provider_entity_id = 'ad-parent-conflict') IS DISTINCT FROM true
  THEN
    RAISE EXCEPTION 'incompatible Ad parent did not fail closed';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'slug-conflict' AND side = 'A'
      AND result->>'status' = 'committed'
      AND result#>>'{counts,actual,storesCreated}' = '1'
  ) OR NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'slug-conflict' AND side = 'B'
      AND result @> '{"status":"blocked","stage":"store_revalidation","reason":"store_slug_collision"}'::jsonb
  ) OR (SELECT count(*) FROM public.stores WHERE slug = 'contended-shared-slug') <> 1
  THEN
    RAISE EXCEPTION 'slug-only collision did not block';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'legacy-store-race' AND side = 'B'
      AND result @> '{"status":"blocked","stage":"store_revalidation","reason":"legacy_identity_collision"}'::jsonb
  ) OR (SELECT count(*) FROM public.stores
        WHERE provider = 'impact'
          AND provider_entity_id = 'campaign-legacy-race'
          AND provider_entity_namespace = 'legacy') <> 1
    OR EXISTS (
      SELECT 1 FROM public.stores
      WHERE provider = 'impact'
        AND provider_entity_id = 'campaign-legacy-race'
        AND provider_entity_namespace = 'campaign'
    )
  THEN
    RAISE EXCEPTION 'concurrent legacy Campaign collision did not fail closed';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM a11_i2_contention.results
    WHERE case_id = 'legacy-offer-race' AND side = 'B'
      AND result @> '{"status":"blocked","stage":"offer_revalidation","reason":"legacy_identity_collision"}'::jsonb
  ) OR (SELECT count(*) FROM public.coupons
        WHERE provider = 'impact'
          AND provider_entity_id = 'ad-legacy-race'
          AND provider_entity_namespace = 'legacy') <> 1
    OR EXISTS (
      SELECT 1 FROM public.coupons
      WHERE provider = 'impact'
        AND provider_entity_id = 'ad-legacy-race'
        AND provider_entity_namespace = 'ad'
    )
    OR EXISTS (
      SELECT 1 FROM public.stores
      WHERE provider = 'impact'
        AND provider_entity_id = 'campaign-legacy-offer-parent'
        AND provider_entity_namespace = 'campaign'
    )
  THEN
    RAISE EXCEPTION 'concurrent legacy Ad collision did not fail closed atomically';
  END IF;

  IF EXISTS (
    SELECT provider, provider_entity_namespace, provider_entity_id
    FROM public.stores
    WHERE provider IS NOT NULL
    GROUP BY provider, provider_entity_namespace, provider_entity_id
    HAVING count(*) > 1
  ) OR EXISTS (
    SELECT provider, provider_entity_namespace, provider_entity_id
    FROM public.coupons
    WHERE provider IS NOT NULL
    GROUP BY provider, provider_entity_namespace, provider_entity_id
    HAVING count(*) > 1
  ) THEN
    RAISE EXCEPTION 'duplicate namespaced catalog identity detected';
  END IF;

  SELECT count(*) INTO result_runs
  FROM a11_i2_contention.results
  WHERE result->>'status' = 'committed';
  SELECT count(*) INTO actual_runs
  FROM public.affiliate_import_runs AS run
  WHERE run.persistence_contract_version = 'v2-a11-ads-1'
    AND run.integration_id IN (
      'a11c0000-0000-4000-8000-000000000001'::uuid,
      'a11c0000-0000-4000-8000-000000000002'::uuid
    );
  IF actual_runs <> result_runs THEN
    RAISE EXCEPTION 'committed result/run mismatch: % vs %', result_runs, actual_runs;
  END IF;
  IF EXISTS (
    SELECT 1
    FROM a11_i2_contention.results AS test_result
    JOIN public.affiliate_import_runs AS run
      ON run.id = (test_result.result->>'runId')::uuid
    WHERE test_result.result->>'status' = 'committed'
      AND (
        run.persistence_execution_status IS DISTINCT FROM 'committed'
        OR run.persistence_counts IS DISTINCT FROM test_result.result->'counts'
        OR (SELECT count(*)
            FROM public.affiliate_import_run_mutations_v2 AS mutation
            WHERE mutation.run_id = run.id) <>
          (run.persistence_counts#>>'{actual,ledgerRows}')::integer
      )
  ) THEN
    RAISE EXCEPTION 'run/ledger reconciliation mismatch';
  END IF;

  RETURN 'A11-S4-I2 Ads contention matrix passed';
END;
$function$;

