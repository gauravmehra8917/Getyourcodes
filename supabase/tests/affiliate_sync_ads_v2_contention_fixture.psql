GRANT USAGE ON SCHEMA a11_i2_contention TO service_role;
GRANT SELECT ON a11_i2_contention.requests TO service_role;
GRANT SELECT, INSERT ON a11_i2_contention.results TO service_role;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA a11_i2_contention TO service_role;
