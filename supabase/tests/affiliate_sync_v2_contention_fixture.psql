\set ON_ERROR_STOP on

DROP SCHEMA IF EXISTS a9c_r1_test CASCADE;
CREATE SCHEMA a9c_r1_test;

CREATE TABLE a9c_r1_test.requests (
  case_id text NOT NULL,
  side text NOT NULL CHECK (side IN ('A', 'B')),
  integration_id uuid NOT NULL,
  actor_id uuid NOT NULL,
  fingerprint text NOT NULL CHECK (fingerprint ~ '^[0-9a-f]{64}$'),
  evaluated_at timestamptz NOT NULL,
  store_action text NOT NULL CHECK (store_action IN ('create', 'noop_existing')),
  campaign_id text NOT NULL,
  slug text NOT NULL,
  promotion_id text,
  offer_kind text CHECK (offer_kind IN ('coupon', 'deal')),
  PRIMARY KEY (case_id, side),
  CHECK ((promotion_id IS NULL) = (offer_kind IS NULL))
);

CREATE TABLE a9c_r1_test.results (
  case_id text NOT NULL,
  side text NOT NULL CHECK (side IN ('A', 'B')),
  result jsonb NOT NULL,
  PRIMARY KEY (case_id, side)
);

CREATE FUNCTION a9c_r1_test.expected_counts(
  _store_create integer,
  _store_existing integer,
  _offer_create integer
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'stores', jsonb_build_object(
      'create', _store_create,
      'noopExisting', _store_existing,
      'blockedAmbiguous', 0,
      'noopUnmatched', 0
    ),
    'offers', jsonb_build_object(
      'create', _offer_create,
      'noopExisting', 0,
      'noopHeld', 0,
      'noopUnresolved', 0
    ),
    'writableStores', _store_create,
    'writableOffers', _offer_create,
    'writableEntities', _store_create + _offer_create
  );
$function$;

CREATE FUNCTION a9c_r1_test.store_create(
  _campaign_id text,
  _slug text,
  _evaluated_at timestamptz
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'instructionOrdinal', 0,
    'action', 'create',
    'provider', 'impact',
    'providerEntityId', _campaign_id,
    'expectedExistingStoreId', NULL,
    'qualified', true,
    'projection', jsonb_build_object(
      'name', 'A9C-R1 ' || _campaign_id,
      'slugCandidate', _slug,
      'description', NULL,
      'affiliateUrl', 'https://tracking.invalid/' || _campaign_id,
      'destinationUrl', 'https://destination.invalid/' || _campaign_id,
      'country', NULL,
      'shippingRegions', '[]'::jsonb,
      'logoSourceUrl', NULL,
      'metadata', jsonb_build_object(
        'advertiserId', 'a9c-r1-advertiser',
        'campaignId', _campaign_id
      ),
      'importOrigin', 'provider',
      'lifecycleManaged', true,
      'lifecycleHidden', false,
      'lastQualificationResult', 'qualified',
      'lastQualifiedAt', _evaluated_at
    )
  );
$function$;

CREATE FUNCTION a9c_r1_test.store_existing(
  _campaign_id text,
  _store_id uuid
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'instructionOrdinal', 0,
    'action', 'noop_existing',
    'provider', 'impact',
    'providerEntityId', _campaign_id,
    'expectedExistingStoreId', _store_id,
    'qualified', true,
    'projection', NULL
  );
$function$;

CREATE FUNCTION a9c_r1_test.offer_create(
  _promotion_id text,
  _kind text,
  _campaign_id text,
  _expected_store_id uuid
)
RETURNS jsonb
LANGUAGE sql
IMMUTABLE
AS $function$
  SELECT jsonb_build_object(
    'instructionOrdinal', 1,
    'action', 'create',
    'provider', 'impact',
    'providerEntityId', _promotion_id,
    'kind', _kind,
    'existingOfferId', NULL,
    'parentProviderEntityId', _campaign_id,
    'expectedParentStoreId', _expected_store_id,
    'projection', jsonb_build_object(
      'title', 'A9C-R1 ' || _promotion_id,
      'description', NULL,
      'couponCode', CASE WHEN _kind = 'coupon' THEN 'A9C-R1-CODE' ELSE NULL END,
      'couponType', CASE WHEN _kind = 'coupon' THEN 'code' ELSE 'deal' END,
      'affiliateUrl', 'https://tracking.invalid/' || _promotion_id,
      'landingPageUrl', NULL,
      'startDate', '2026-08-01',
      'expiryDate', '2026-12-31',
      'status', 'active',
      'terms', CASE WHEN _kind = 'coupon' THEN 'A9C-R1 local fixture' ELSE NULL END,
      'discountType', NULL,
      'discountValue', NULL,
      'metadata', jsonb_build_object(
        'advertiserId', 'a9c-r1-advertiser',
        'campaignId', _campaign_id,
        'programId', NULL,
        'resolvedCampaignId', _campaign_id
      )
    )
  );
$function$;

CREATE FUNCTION a9c_r1_test.execute_request(_case_id text, _side text)
RETURNS jsonb
LANGUAGE plpgsql
AS $function$
DECLARE
  request a9c_r1_test.requests%ROWTYPE;
  store_id uuid;
  stores jsonb;
  offers jsonb;
BEGIN
  SELECT * INTO STRICT request
  FROM a9c_r1_test.requests
  WHERE case_id = _case_id AND side = _side;

  IF request.store_action = 'create' THEN
    store_id := NULL;
    stores := jsonb_build_array(a9c_r1_test.store_create(
      request.campaign_id,
      request.slug,
      request.evaluated_at
    ));
  ELSE
    SELECT id INTO STRICT store_id
    FROM public.stores
    WHERE provider = 'impact'
      AND provider_entity_id = request.campaign_id;
    stores := jsonb_build_array(a9c_r1_test.store_existing(
      request.campaign_id,
      store_id
    ));
  END IF;

  offers := CASE WHEN request.promotion_id IS NULL
    THEN '[]'::jsonb
    ELSE jsonb_build_array(a9c_r1_test.offer_create(
      request.promotion_id,
      request.offer_kind,
      request.campaign_id,
      store_id
    ))
  END;

  RETURN public.apply_affiliate_persistence_plan_v2(
    request.integration_id,
    'impact',
    'v2-a9b-1',
    'sha256-canonical-plan-v1',
    request.fingerprint,
    request.evaluated_at,
    request.actor_id,
    a9c_r1_test.expected_counts(
      CASE WHEN request.store_action = 'create' THEN 1 ELSE 0 END,
      CASE WHEN request.store_action = 'noop_existing' THEN 1 ELSE 0 END,
      CASE WHEN request.promotion_id IS NULL THEN 0 ELSE 1 END
    ),
    stores,
    offers
  );
END;
$function$;

CREATE FUNCTION a9c_r1_test.assert_true(_condition boolean, _label text)
RETURNS void
LANGUAGE plpgsql
AS $function$
BEGIN
  IF _condition IS DISTINCT FROM true THEN
    RAISE EXCEPTION 'a9c_r1_contention_assertion_failed: %', _label;
  END IF;
END;
$function$;

CREATE FUNCTION a9c_r1_test.validate_results()
RETURNS text
LANGUAGE plpgsql
AS $function$
DECLARE
  case_number integer;
  case_name text;
  result_a jsonb;
  result_b jsonb;
  campaign text;
  promotion text;
  shared_store_id uuid;
  row_count integer;
  run_record record;
BEGIN
  PERFORM a9c_r1_test.assert_true(
    (SELECT count(*) = 14 FROM a9c_r1_test.results),
    'all fourteen bounded results exist'
  );
  PERFORM a9c_r1_test.assert_true(
    NOT EXISTS (
      SELECT 1 FROM a9c_r1_test.results WHERE result->>'status' = 'failed'
    ),
    'no contention result is failed/internal_failure'
  );

  FOR case_number IN 1..3 LOOP
    case_name := 'same-' || case_number;
    campaign := 'a9c-r1-same-campaign-' || case_number;
    promotion := 'a9c-r1-same-promotion-' || case_number;
    SELECT result INTO STRICT result_a FROM a9c_r1_test.results
      WHERE case_id = case_name AND side = 'A';
    SELECT result INTO STRICT result_b FROM a9c_r1_test.results
      WHERE case_id = case_name AND side = 'B';
    PERFORM a9c_r1_test.assert_true(
      result_a->>'status' = 'committed'
        AND result_b->>'status' = 'committed',
      case_name || ' both executions committed'
    );
    PERFORM a9c_r1_test.assert_true(
      result_a#>>'{counts,actual,storesCreated}' = '1'
        AND result_a#>>'{counts,actual,offersCreated}' = '1'
        AND result_b#>>'{counts,actual,storesNoopExisting}' = '1'
        AND result_b#>>'{counts,actual,offersNoopExisting}' = '1',
      case_name || ' has one creator and one create-to-noop execution'
    );
    PERFORM a9c_r1_test.assert_true(
      (SELECT count(*) = 1 FROM public.stores
       WHERE provider = 'impact' AND provider_entity_id = campaign)
        AND
      (SELECT count(*) = 1 FROM public.coupons
       WHERE provider = 'impact' AND provider_entity_id = promotion),
      case_name || ' has one exact store and offer identity'
    );
    SELECT id INTO STRICT shared_store_id FROM public.stores
      WHERE provider = 'impact' AND provider_entity_id = campaign;
    PERFORM a9c_r1_test.assert_true(
      (SELECT bool_and(coupon.store_id = shared_store_id)
       FROM public.coupons AS coupon
       WHERE coupon.provider = 'impact' AND coupon.provider_entity_id = promotion),
      case_name || ' offer has the exact shared parent'
    );
    PERFORM a9c_r1_test.assert_true(
      (SELECT count(*) = 2
       FROM public.affiliate_import_runs AS run
       JOIN a9c_r1_test.requests AS request
         ON request.integration_id = run.integration_id
        AND request.fingerprint = run.plan_fingerprint
       WHERE request.case_id = case_name),
      case_name || ' has two durable runs'
    );
    PERFORM a9c_r1_test.assert_true(
      (SELECT count(*) = 4
         AND count(*) FILTER (WHERE mutation.planned_action = 'create') = 4
         AND count(*) FILTER (WHERE mutation.entity_kind = 'store' AND mutation.outcome = 'created') = 1
         AND count(*) FILTER (WHERE mutation.entity_kind = 'store' AND mutation.outcome = 'noop_existing') = 1
         AND count(*) FILTER (WHERE mutation.entity_kind = 'offer' AND mutation.outcome = 'created') = 1
         AND count(*) FILTER (WHERE mutation.entity_kind = 'offer' AND mutation.outcome = 'noop_existing') = 1
         AND count(DISTINCT mutation.entity_id) FILTER (WHERE mutation.entity_kind = 'store') = 1
         AND count(DISTINCT mutation.entity_id) FILTER (WHERE mutation.entity_kind = 'offer') = 1
       FROM public.affiliate_import_run_mutations_v2 AS mutation
       JOIN public.affiliate_import_runs AS run ON run.id = mutation.run_id
       JOIN a9c_r1_test.requests AS request
         ON request.integration_id = run.integration_id
        AND request.fingerprint = run.plan_fingerprint
       WHERE request.case_id = case_name),
      case_name || ' ledger records deterministic create-to-noop evidence'
    );
  END LOOP;

  SELECT result INTO STRICT result_a FROM a9c_r1_test.results
    WHERE case_id = 'different-offers' AND side = 'A';
  SELECT result INTO STRICT result_b FROM a9c_r1_test.results
    WHERE case_id = 'different-offers' AND side = 'B';
  SELECT id INTO STRICT shared_store_id FROM public.stores
    WHERE provider = 'impact'
      AND provider_entity_id = 'a9c-r1-different-offers-campaign';
  PERFORM a9c_r1_test.assert_true(
    result_a->>'status' = 'committed' AND result_b->>'status' = 'committed'
      AND result_a#>>'{counts,actual,storesCreated}' = '1'
      AND result_b#>>'{counts,actual,storesNoopExisting}' = '1'
      AND result_a#>>'{counts,actual,offersCreated}' = '1'
      AND result_b#>>'{counts,actual,offersCreated}' = '1',
    'same store/different offers has coherent committed outcomes'
  );
  PERFORM a9c_r1_test.assert_true(
    (SELECT count(*) = 2 AND bool_and(coupon.store_id = shared_store_id)
     FROM public.coupons AS coupon
     WHERE coupon.provider = 'impact'
       AND coupon.provider_entity_id IN ('a9c-r1-promotion-a', 'a9c-r1-promotion-b')),
    'same store/different offers has two offers with one exact parent'
  );

  SELECT result INTO STRICT result_a FROM a9c_r1_test.results
    WHERE case_id = 'offer-compatible' AND side = 'A';
  SELECT result INTO STRICT result_b FROM a9c_r1_test.results
    WHERE case_id = 'offer-compatible' AND side = 'B';
  PERFORM a9c_r1_test.assert_true(
    result_a->>'status' = 'committed' AND result_b->>'status' = 'committed'
      AND result_a#>>'{counts,actual,offersCreated}' = '1'
      AND result_b#>>'{counts,actual,offersNoopExisting}' = '1'
      AND result_a#>>'{counts,actual,storesNoopExisting}' = '1'
      AND result_b#>>'{counts,actual,storesNoopExisting}' = '1'
      AND
      (SELECT count(*) = 1 FROM public.coupons
       WHERE provider = 'impact'
         AND provider_entity_id = 'a9c-r1-compatible-promotion'),
    'offer-only race has one creator and one exact no-op'
  );

  SELECT result INTO STRICT result_a FROM a9c_r1_test.results
    WHERE case_id = 'kind-conflict' AND side = 'A';
  SELECT result INTO STRICT result_b FROM a9c_r1_test.results
    WHERE case_id = 'kind-conflict' AND side = 'B';
  PERFORM a9c_r1_test.assert_true(
    result_a->>'status' = 'committed'
      AND result_b = jsonb_build_object(
        'status', 'blocked',
        'stage', 'offer_revalidation',
        'reason', 'offer_kind_conflict'
      )
      AND
      (SELECT count(*) = 1 AND bool_and(coupon_type::text = 'code')
       FROM public.coupons
       WHERE provider = 'impact'
         AND provider_entity_id = 'a9c-r1-kind-conflict-promotion')
      AND NOT EXISTS (
        SELECT 1 FROM public.affiliate_import_runs
        WHERE integration_id = '91000000-0000-4000-8000-000000000002'
          AND plan_fingerprint = '1ab5b14f228b5f2368ffe888f129df991aa2280f86f4e25856a47b5c3d849b70'
      ),
    'incompatible kind loser blocks without evidence or reclassification'
  );

  SELECT result INTO STRICT result_a FROM a9c_r1_test.results
    WHERE case_id = 'slug-conflict' AND side = 'A';
  SELECT result INTO STRICT result_b FROM a9c_r1_test.results
    WHERE case_id = 'slug-conflict' AND side = 'B';
  PERFORM a9c_r1_test.assert_true(
    result_a->>'status' = 'committed'
      AND result_b = jsonb_build_object(
        'status', 'blocked',
        'stage', 'store_revalidation',
        'reason', 'store_slug_collision'
      )
      AND (SELECT count(*) = 1 FROM public.stores WHERE slug = 'a9c-r1-shared-slug')
      AND NOT EXISTS (
        SELECT 1 FROM public.stores
        WHERE provider = 'impact'
          AND provider_entity_id = 'a9c-r1-slug-campaign-b'
      )
      AND NOT EXISTS (
        SELECT 1 FROM public.affiliate_import_runs
        WHERE integration_id = '91000000-0000-4000-8000-000000000002'
          AND plan_fingerprint = '215ed1260ddcb69d5c775f73b33222a4e1e2d360304e4681bf5c9da8f31c82b1'
      ),
    'concurrent slug loser blocks without adoption or partial evidence'
  );

  PERFORM a9c_r1_test.assert_true(
    (SELECT count(*) = 12
     FROM public.affiliate_import_runs AS run
     JOIN a9c_r1_test.requests AS request
       ON request.integration_id = run.integration_id
      AND request.fingerprint = run.plan_fingerprint),
    'twelve successful logical executions have durable runs'
  );
  PERFORM a9c_r1_test.assert_true(
    (SELECT count(*) = 23
     FROM public.affiliate_import_run_mutations_v2 AS mutation
     JOIN public.affiliate_import_runs AS run ON run.id = mutation.run_id
     JOIN a9c_r1_test.requests AS request
       ON request.integration_id = run.integration_id
      AND request.fingerprint = run.plan_fingerprint),
    'successful runs have twenty-three expected ledger rows'
  );

  FOR run_record IN
    SELECT run.*
    FROM public.affiliate_import_runs AS run
    JOIN a9c_r1_test.requests AS request
      ON request.integration_id = run.integration_id
     AND request.fingerprint = run.plan_fingerprint
  LOOP
    SELECT count(*) INTO row_count
    FROM public.affiliate_import_run_mutations_v2
    WHERE run_id = run_record.id;
    PERFORM a9c_r1_test.assert_true(
      row_count = (run_record.persistence_counts#>>'{actual,ledgerRows}')::integer
        AND
      (SELECT count(*) = count(DISTINCT instruction_ordinal)
       FROM public.affiliate_import_run_mutations_v2
       WHERE run_id = run_record.id),
      'run ' || run_record.id || ' ledger count and ordinals reconcile'
    );
  END LOOP;

  PERFORM a9c_r1_test.assert_true(
    NOT EXISTS (
      SELECT 1
      FROM public.affiliate_import_run_mutations_v2 AS mutation
      LEFT JOIN public.affiliate_import_runs AS run ON run.id = mutation.run_id
      WHERE run.id IS NULL
    ),
    'no orphan ledger rows exist'
  );
  PERFORM a9c_r1_test.assert_true(
    NOT EXISTS (
      SELECT 1
      FROM public.affiliate_import_run_mutations_v2 AS mutation
      JOIN public.affiliate_import_runs AS run ON run.id = mutation.run_id
      JOIN a9c_r1_test.requests AS request
        ON request.integration_id = run.integration_id
       AND request.fingerprint = run.plan_fingerprint
      LEFT JOIN public.stores AS store
        ON mutation.entity_kind = 'store'
       AND store.id = mutation.entity_id
       AND store.provider = mutation.provider
       AND store.provider_entity_id = mutation.provider_entity_id
      LEFT JOIN public.coupons AS offer
        ON mutation.entity_kind = 'offer'
       AND offer.id = mutation.entity_id
       AND offer.provider = mutation.provider
       AND offer.provider_entity_id = mutation.provider_entity_id
       AND offer.store_id = mutation.parent_entity_id
      WHERE (mutation.entity_kind = 'store' AND store.id IS NULL)
         OR (mutation.entity_kind = 'offer' AND offer.id IS NULL)
    ),
    'every ledger entity and offer parent resolves exactly'
  );
  PERFORM a9c_r1_test.assert_true(
    NOT EXISTS (
      SELECT provider, provider_entity_id
      FROM public.stores
      WHERE provider = 'impact' AND provider_entity_id LIKE 'a9c-r1-%'
      GROUP BY provider, provider_entity_id HAVING count(*) > 1
    )
      AND NOT EXISTS (
        SELECT provider, provider_entity_id
        FROM public.coupons
        WHERE provider = 'impact' AND provider_entity_id LIKE 'a9c-r1-%'
        GROUP BY provider, provider_entity_id HAVING count(*) > 1
      ),
    'no synthetic exact provider identity is duplicated'
  );

  RETURN 'A9C-R1 contention matrix passed';
END;
$function$;

